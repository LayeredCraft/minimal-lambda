{
  "Information": [
    "Defaults for packaging and deploying the executable MinimalLambda durable example with Amazon.Lambda.Tools 7.",
    "Deployment commands are documented in docs/guides/durable-execution-deployment.md."
  ],
  "configuration": "Release",
  "framework": "net8.0",
  "package-type": "Zip",
  "function-runtime": "dotnet8",
  "function-handler": "MinimalLambda.Example.DurableExecution",
  "function-memory-size": 512,
  "function-timeout": 30,
  "function-publish": true,
  "durable-execution-timeout": 86400,
  "durable-retention-period": 7
}
