<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Optional scoped event processing for MinimalLambda</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="MinimalLambda.EventProcessing" />
    <Using Include="MinimalLambda.Builder" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core owns the analyzer; allow it through this optional dependency. -->
    <ProjectReference Include="../MinimalLambda/MinimalLambda.csproj" PrivateAssets="none" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MinimalLambda.EventProcessing.UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
