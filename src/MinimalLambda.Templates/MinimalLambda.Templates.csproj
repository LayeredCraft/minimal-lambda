<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>MinimalLambda.Templates</PackageId>
    <Title>MinimalLambda Templates</Title>
    <Description>dotnet new templates for MinimalLambda AWS Lambda projects.</Description>
    <PackageType>Template</PackageType>
    <PackageTags>dotnet-new;templates;minimal-lambda;aws;lambda</PackageTags>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*" Exclude="templates\**\bin\**;templates\**\obj\**"/>
  </ItemGroup>
</Project>
