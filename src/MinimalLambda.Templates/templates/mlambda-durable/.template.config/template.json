{
  "$schema": "http://json.schemastore.org/template",
  "author": "MinimalLambda",
  "classifications": ["AWS", "Lambda", "Durable Execution"],
  "name": "MinimalLambda AWS Lambda Durable Execution Function",
  "identity": "MinimalLambda.Templates.DurableExecutionFunction.CSharp",
