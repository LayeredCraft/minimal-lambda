    "region": {
      "type": "parameter",
      "description": "AWS region stored in aws-lambda-tools-defaults.json.",
      "datatype": "string",
      "replaces": "DefaultRegion",
      "defaultValue": ""
    }
  },
  "primaryOutputs": [{ "path": "./src/BlueprintBaseName.1/BlueprintBaseName.1.csproj" }]
